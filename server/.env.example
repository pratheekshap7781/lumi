# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string
# Get this from your Atlas cluster: Database > Connect > Drivers
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Secret key used to sign authentication tokens (JWT).
# Use a long, random string. You can generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# URL of the frontend, used to allow it to make authenticated requests (CORS)
CLIENT_URL=http://localhost:5173

# Will be added in the AI processing stage:
# AI_API_KEY=
